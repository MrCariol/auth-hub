# Contenuto di riferimento per il .env da creare A MANO sul server (via File
# Manager), UNA SOLA VOLTA al primo deploy. Non viene mai caricato da
# deploy.sh: l'app in produzione lo ignora finché non lo crei tu.

APP_NAME="Auth example.it"
APP_ENV=production
APP_KEY=base64:xwG9bwiWUupwglrufgzUbyabGtbgD3HDwPWTKqk2eEQ=
APP_DEBUG=false
APP_URL=https://auth.example.it

HOMEPAGE_URL=https://example.it
PWA_TOKEN_TTL_MINUTES=43200

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

DB_CONNECTION=sqlite
# il file viene creato automaticamente da watcher.php al primo deploy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error

MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="no-reply@example.it"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_NOTIFICATION_ADDRESS="admin@example.com"
