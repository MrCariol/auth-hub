# Copia questo file in deploy/.env.deploy e compila i tuoi dati.
# deploy/.env.deploy NON va mai committato (è già in .gitignore).

FTP_HOST=ftp.example.com
FTP_USER=nomeutente
FTP_PASS=password
# true = FTPS esplicito (consigliato se il tuo host lo supporta), false = FTP in chiaro
FTP_SECURE=true

# Percorso della cartella app COME LO VEDE L'FTP (spesso relativo alla home,
# es. "/deploy" se l'FTP è già "chrootato" nella tua home). Qui verranno
# caricati release.tar.gz e watcher.php.
FTP_REMOTE_DIR=/deploy

# Percorso ASSOLUTO della stessa cartella sul filesystem del server (quello
# che userai nel comando del cron job, es. /home/tuoutente/deploy).
# Non è usato dallo script, serve solo come promemoria per configurare il cron:
#   * * * * * php APP_ABS_PATH/artisan schedule:run >> /dev/null 2>&1
# (unico cron per tutto ciò che è schedulato in Laravel, incluso il deploy)
APP_ABS_PATH=/home/tuoutente/deploy
